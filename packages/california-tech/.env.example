# Example Environment Configuration for QWER-Test + Symbiont Integration

# ============================================================================
# REQUIRED FOR SYNCING: Nhost Admin Secret
# ============================================================================
# Only needed for webhook/sync operations and image uploads (server-side)
# Get this from your Nhost project dashboard → Settings → Environment Variables
# NOT needed for client-side reading of posts
NHOST_ADMIN_SECRET=your-admin-secret-here

# ============================================================================
# OPTIONAL: Notion Integration
# ============================================================================
# Only needed if running symbiont sync operations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# OPTIONAL: Webhook Security
# ============================================================================
# Secret for authenticating scheduled sync jobs
CRON_SECRET=your-random-secret-here

# ============================================================================
# OPTIONAL: Source ID Filter
# ============================================================================
# Filter posts by specific database source (if using multiple Notion DBs)
# DEFAULT_SOURCE_ID=my-blog

# ============================================================================
# Example Full Configuration
# ============================================================================
# Copy this file to `.env` in packages/qwer-test/ directory
# Replace the placeholder values with your actual credentials
